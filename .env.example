# Leave REACT_APP_API_BASE_URL empty to run in demo mode: the app serves a
# seeded board from localStorage and needs no backend at all.
REACT_APP_API_BASE_URL=

# Force demo mode on even when an API base URL is set (true | false).
# Defaults to true when REACT_APP_API_BASE_URL is empty.
REACT_APP_DEMO_MODE=

# Dev server port. Any free port works.
PORT=3000

# Abandon a request after this many milliseconds.
REACT_APP_REQUEST_TIMEOUT_MS=15000

# Rows per page in the task list.
REACT_APP_PAGE_SIZE=8

# Natural-language quick capture.
#   local  - deterministic rule parser, no network, no key (default)
#   remote - OpenAI-compatible chat completions endpoint
REACT_APP_AI_PROVIDER=local
REACT_APP_AI_ENDPOINT=
REACT_APP_AI_API_KEY=
REACT_APP_AI_MODEL=gpt-4o-mini
