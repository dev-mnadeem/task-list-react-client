# Leave VITE_API_BASE_URL empty to run in demo mode: the app serves a
# seeded board from localStorage and needs no backend at all.
VITE_API_BASE_URL=

# Force demo mode on even when an API base URL is set (true | false).
# Defaults to true when VITE_API_BASE_URL is empty.
VITE_DEMO_MODE=

# Dev server port (npm start). Any free port works.
PORT=3000

# Abandon a request after this many milliseconds.
VITE_REQUEST_TIMEOUT_MS=15000

# Rows per page in the task list.
VITE_PAGE_SIZE=8

# Natural-language quick capture.
#   local  - deterministic rule parser, no network, no key (default)
#   remote - OpenAI-compatible chat completions endpoint
# Every VITE_* value is inlined into the JavaScript bundle and is readable by
# anyone who loads the page, so only point VITE_AI_API_KEY at a key that is
# meant to be public (for example one issued by your own rate-limited proxy).
VITE_AI_PROVIDER=local
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini
